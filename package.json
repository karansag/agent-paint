{
  "name": "agent-paint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/App.jsx --bundle --format=esm --target=es2022 --outfile=public/app.js --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --minify",
    "start": "npm run build && node --env-file-if-exists=.env server.js",
    "dev": "npm run build && node --watch --env-file-if-exists=.env server.js",
    "test": "node --test 'test/*.test.js'"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "playwright": "^1.60.0"
  }
}
