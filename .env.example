# Agent Paint environment
# Copy to .env and fill in the keys you want to use.
# Run with: node --env-file=.env server.js

# Default provider when the server starts.
# The UI can still switch providers per request.
# Supported values in code: llama, openai, anthropic, custom
LLM_PROVIDER=openai

# How visitors may use the API keys configured below:
#   open (default) - keys fill in whenever the browser omits one; local use
#   demo           - keys work but model turns are rate limited; public demos
#   byok           - keys are never shared; visitors paste their own
# In every mode a server key is only sent to the provider's own endpoint,
# never to a base URL typed into the UI.
KEY_MODE=open

# Demo mode limits (used only when KEY_MODE=demo).
DEMO_TURNS_PER_HOUR=20
DEMO_TURNS_PER_DAY=400
DEMO_MAX_TOKENS=2000

# Optional startup/default endpoint overrides.
# Leave blank to use the provider preset from lib/providers.js.
LLM_BASE_URL=
LLM_CHAT_PATH=
LLM_MODEL=
LLM_MAX_TOKENS=2000

# Local llama.cpp.
# Leave blank unless your local llama-server is behind auth.
LLAMA_API_KEY=

# OpenAI.
# Provider preset: https://api.openai.com/v1/chat/completions
# Default model in code: gpt-4.1-mini
OPENAI_API_KEY=

# Anthropic Claude through Anthropic's OpenAI-compatible endpoint.
# Provider preset: https://api.anthropic.com/v1/chat/completions
# Default model in code: claude-opus-4-8
ANTHROPIC_API_KEY=

# Generic fallback for custom OpenAI-compatible providers.
# The custom provider reads LLM_API_KEY first, then OPENAI_API_KEY.
LLM_API_KEY=
